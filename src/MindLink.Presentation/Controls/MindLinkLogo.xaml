<UserControl x:Class="MindLink.Presentation.Controls.MindLinkLogo"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </UserControl.Resources>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="{Binding LogoSize, ElementName=Root}"
            Height="{Binding LogoSize, ElementName=Root}"
            Background="#635BFF"
            CornerRadius="10"
            Effect="{StaticResource BrandShadow}">
      <Viewbox Margin="7">
        <Path Data="M50,0 L60,32 L92,42 L60,52 L50,84 L40,52 L8,42 L40,32 Z"
              Fill="White" />
      </Viewbox>
    </Border>
    <TextBlock Text="MindLink"
               Margin="10,0,0,0"
               VerticalAlignment="Center"
               FontFamily="Segoe UI Variable Display"
               FontSize="{Binding TextFontSize, ElementName=Root}"
               FontWeight="Bold"
               Visibility="{Binding ShowText, ElementName=Root, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock.Foreground><Binding Path="TextForeground" ElementName="Root" /></TextBlock.Foreground>
    </TextBlock>
  </StackPanel>
</UserControl>
