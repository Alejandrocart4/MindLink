<UserControl x:Class="MindLink.Presentation.Views.KnowledgeNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="540">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DrawingBrush x:Key="GraphGridBrush" TileMode="Tile"
                  Viewport="0,0,32,32" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 32,0 32,32">
          <GeometryDrawing.Pen>
            <Pen Brush="#DDEAF0" Thickness="0.75" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="GraphNodeButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="#F8FBFD">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" MinWidth="400" />
      <ColumnDefinition Width="264" />
    </Grid.ColumnDefinitions>

    <!-- Herramientas y leyenda -->
    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,1,0">
      <StackPanel>
        <Border Padding="16,16,16,14" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="Red de conocimiento" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource BrandNavy}" Margin="0,0,0,12" />

            <Border Background="#F5F9FB" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="8" ClipToBounds="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding ShowNetworkCommand}" Content="⌘  Red">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNetworkView}" Value="True">
                          <Setter Property="Background" Value="{StaticResource SoftBlue}" />
                          <Setter Property="Foreground" Value="{StaticResource BrandBlue}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Grid.Column="1" Command="{Binding ShowListCommand}" Content="☷  Lista">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                          <Setter Property="Background" Value="{StaticResource SoftBlue}" />
                          <Setter Property="Foreground" Value="{StaticResource BrandBlue}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="32" Height="30"
                      MinWidth="0" MinHeight="0" Padding="4" FontSize="13"
                      Command="{Binding ZoomOutCommand}" ToolTip="Alejar" Content="−" />
              <Button Grid.Column="1" Style="{StaticResource TextButton}" Padding="4"
                      Command="{Binding ResetZoomCommand}" ToolTip="Restablecer zoom">
                <TextBlock Text="{Binding ZoomLabel}" FontFamily="Consolas" FontSize="11.5"
                           Foreground="{StaticResource TextMuted}" />
              </Button>
              <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="30"
                      MinWidth="0" MinHeight="0" Padding="4" FontSize="13"
                      Command="{Binding ZoomInCommand}" ToolTip="Acercar" Content="＋" />
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Margin="16,17,16,0">
          <TextBlock Text="LEYENDA" FontSize="10.5" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSubtle}" Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Legend}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="11" Height="11" Fill="{Binding AccentColor}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="9,0,0,0"
                             FontSize="12" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Column="2" Text="{Binding Count}" FontFamily="Consolas"
                             FontSize="10.5" Foreground="{StaticResource TextSubtle}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{StaticResource Border}" Margin="-16,13,-16,16" />
          <TextBlock Text="FILTROS" FontSize="10.5" FontWeight="SemiBold"
                     Foreground="{StaticResource TextSubtle}" Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Filters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                        Padding="0" Margin="0,0,0,9" HorizontalContentAlignment="Stretch" Cursor="Hand">
                  <StackPanel Orientation="Horizontal">
                    <Border x:Name="CheckBox" Width="15" Height="15" CornerRadius="3"
                            Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1.2">
                      <TextBlock x:Name="CheckMark" Text="✓" FontSize="10" FontWeight="Bold"
                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    </Border>
                    <TextBlock Text="{Binding Label}" Margin="9,0,0,0" FontSize="11.5"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CheckBox" Property="Background" Value="{StaticResource BrandTealDark}" />
                    <Setter TargetName="CheckBox" Property="BorderBrush" Value="{StaticResource BrandTealDark}" />
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Red interactiva -->
    <Grid Grid.Column="1" Background="{StaticResource GraphGridBrush}"
          Visibility="{Binding IsNetworkView, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Viewbox Stretch="Uniform" Margin="24,30,24,54">
        <Grid Width="700" Height="420" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
          </Grid.RenderTransform>

          <ItemsControl Width="700" Height="420" ItemsSource="{Binding Connections}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><Canvas Width="700" Height="420" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="0" />
                <Setter Property="Canvas.Top" Value="0" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Canvas Width="700" Height="420">
                  <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                        Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                        Opacity="{Binding Opacity}" StrokeDashArray="4,3" />
                  <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                          Background="#EAF7F8" CornerRadius="7" Padding="5,2"
                          Opacity="{Binding Opacity}">
                    <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandPetroleum}" />
                  </Border>
                </Canvas>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl Width="700" Height="420" ItemsSource="{Binding Nodes}"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><Canvas Width="700" Height="420" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding HaloLeft}" />
                <Setter Property="Canvas.Top" Value="{Binding HaloTop}" />
                <Setter Property="Opacity" Value="{Binding Opacity}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource GraphNodeButton}"
                        Width="{Binding HaloDiameter}" Height="{Binding HaloDiameter}"
                        Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" ToolTip="{Binding Label}">
                  <Grid>
                    <Ellipse x:Name="SelectionHalo" Margin="0" Fill="#16009BA9"
                             Stroke="#5B009BA9" StrokeThickness="1.4" StrokeDashArray="3,2"
                             Visibility="Collapsed" />
                    <Ellipse Margin="8" Fill="White" Opacity="0.9" />
                    <Ellipse Margin="12" Fill="{Binding AccentColor}" Stroke="#3301153E" StrokeThickness="1.5" />
                    <TextBlock Text="{Binding ShortLabel}" Width="124" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="NoWrap" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                  </Grid>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="SelectionHalo" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Viewbox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Margin="20,0,0,18">
        <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="8" Padding="11,7" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding NodeCount}" FontFamily="Consolas" FontWeight="Bold"
                       Foreground="{StaticResource BrandTeal}" />
            <TextBlock Text="  Nodos" FontSize="11" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="8" Padding="11,7">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ConnectionCount}" FontFamily="Consolas" FontWeight="Bold"
                       Foreground="{StaticResource BrandTeal}" />
            <TextBlock Text="  Conexiones" FontSize="11" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
              Background="{StaticResource SoftGreen}" BorderBrush="#BFE6CE" BorderThickness="1"
              CornerRadius="8" Padding="12,7">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="#27864F" />
      </Border>
    </Grid>

    <!-- Vista alternativa en lista -->
    <Grid Grid.Column="1" Background="{StaticResource AppBackground}"
          Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
          <Grid Margin="0,0,0,15">
            <TextBlock Text="Todos los nodos" Style="{StaticResource SectionTitle}" />
            <TextBlock HorizontalAlignment="Right" Text="Selecciona un elemento para ver sus conexiones"
                       FontSize="11.5" Foreground="{StaticResource TextMuted}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Nodes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SecondaryButton}" Padding="14,11" Margin="0,0,0,8"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12" Height="12" Fill="{Binding AccentColor}" Margin="0,0,11,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimary}" />
                      <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="10.5"
                                 Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource TagPill}" Padding="8,3">
                      <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{StaticResource BrandPetroleum}" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Detalle del nodo -->
    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Border}"
            BorderThickness="1,0,0,0">
      <Grid>
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Padding="16,16,14,14" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
              <StackPanel>
                <Border HorizontalAlignment="Left" Background="{StaticResource SoftBlue}"
                        CornerRadius="10" Padding="9,3" Margin="0,0,0,10">
                  <TextBlock Text="{Binding SelectedNode.KindLabel}" FontSize="9.5" FontWeight="Bold"
                             Foreground="{StaticResource BrandPetroleum}" />
                </Border>
                <TextBlock Text="{Binding SelectedNode.Label}" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource BrandNavy}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedNode.Subtitle}" Margin="0,5,28,0" FontSize="10.5"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
              </StackPanel>
              <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TextButton}"
                      Padding="5,1" Command="{Binding ClearSelectionCommand}" Content="×" />
            </Grid>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,18">
              <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSubtle}">
                <Run Text="CONEXIONES (" /><Run Text="{Binding SelectedConnections.Count, Mode=OneWay}" /><Run Text=")" />
              </TextBlock>
              <ItemsControl ItemsSource="{Binding SelectedConnections}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FBFDFE" BorderBrush="#E4EEF2" BorderThickness="1"
                            CornerRadius="8" Padding="10,9" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Fill="{Binding Node.AccentColor}" Margin="0,0,9,0" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Node.Label}" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Relation}" Margin="0,2,0,0" FontSize="9.5"
                                     Foreground="{StaticResource BrandTeal}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{StaticResource TextSubtle}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Style="{StaticResource SecondaryButton}" Margin="0,7,0,0" Padding="12,9"
                      BorderBrush="#81D1D7" Foreground="{StaticResource BrandTealDark}"
                      Command="{Binding CreateRelationshipCommand}" Content="🔗  Crear nueva relación" />
            </StackPanel>
          </ScrollViewer>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="⌘" HorizontalAlignment="Center" FontSize="28" Foreground="{StaticResource TextSubtle}" />
          <TextBlock Text="Selecciona un nodo" Margin="0,10,0,0" FontWeight="SemiBold"
                     Foreground="{StaticResource BrandNavy}" />
          <TextBlock Text="Aquí aparecerán sus relaciones." Margin="0,4,0,0" FontSize="11"
                     Foreground="{StaticResource TextMuted}" TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
