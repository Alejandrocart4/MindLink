<UserControl x:Class="MindLink.Presentation.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MindLink.Presentation.Controls"
             Background="White">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="520" />
    </Grid.ColumnDefinitions>

    <Grid Background="White">
      <Ellipse Width="330" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="-120,-120,0,0" Opacity="0.07" Fill="{StaticResource BrandTeal}" />
      <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,-90,-90" Opacity="0.05" Fill="{StaticResource BrandBlue}" />

      <StackPanel Width="540" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="64,0,0,0">
        <controls:MindLinkLogo LogoSize="40" TextFontSize="20" HorizontalAlignment="Left" Margin="0,0,0,36" />

        <TextBlock Text="Conecta tus ideas."
                   FontFamily="Segoe UI Variable Display" FontSize="42" FontWeight="Bold"
                   Foreground="{StaticResource BrandNavy}" LineHeight="48" />
        <TextBlock Text="Estructura tu conocimiento."
                   FontFamily="Segoe UI Variable Display" FontSize="42" FontWeight="Bold"
                   LineHeight="48" Margin="0,-2,0,0">
          <TextBlock.Foreground>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#003280" Offset="0" />
              <GradientStop Color="#009BA9" Offset="1" />
            </LinearGradientBrush>
          </TextBlock.Foreground>
        </TextBlock>

        <TextBlock Margin="0,22,0,0" Width="470" HorizontalAlignment="Left"
                   Text="Organiza notas, referencias y proyectos de investigación en un solo espacio. Un ecosistema local que transforma investigaciones fragmentadas en conocimiento estructurado y narrativas publicables."
                   Foreground="{StaticResource TextSecondary}" FontSize="16" LineHeight="26"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,38,0,0">
          <Button Style="{StaticResource PrimaryButton}" Content="Comenzar"
                  Command="{Binding StartCommand}" Padding="28,13" FontSize="15" />
          <Button Style="{StaticResource SecondaryButton}" Content="Abrir proyecto existente"
                  Command="{Binding OpenProjectCommand}" Padding="28,13" FontSize="15" Margin="12,0,0,0" />
        </StackPanel>

        <Border Width="400" HorizontalAlignment="Left" Margin="0,46,0,0" Padding="16,14"
                Background="#0D009BA9" BorderBrush="#26009BA9" BorderThickness="1" CornerRadius="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="🔒" FontSize="14" Foreground="{StaticResource BrandTeal}" Margin="0,1,0,0" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="Aplicación 100% local" Foreground="{StaticResource BrandPetroleum}"
                         FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="Todos tus datos se almacenan en tu dispositivo. Tu investigación es privada y segura sin necesidad de conexión a internet."
                         Foreground="#5A8096" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Column="1" Background="{StaticResource WelcomeGradient}" ClipToBounds="True">
      <Ellipse Width="210" Height="210" Margin="-40,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Fill="White" Opacity="0.035" />
      <Ellipse Width="170" Height="170" Margin="0,0,-30,100" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Fill="White" Opacity="0.035" />

      <StackPanel Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Viewbox Width="380" Height="320">
          <Canvas Width="380" Height="320">
            <Line X1="190" Y1="100" X2="90" Y2="180" Stroke="#66009BA9" StrokeThickness="1.5" StrokeDashArray="4 3" />
            <Line X1="190" Y1="100" X2="290" Y2="170" Stroke="#66009BA9" StrokeThickness="1.5" StrokeDashArray="4 3" />
            <Line X1="190" Y1="100" X2="190" Y2="220" Stroke="#66009BA9" StrokeThickness="1.5" StrokeDashArray="4 3" />
            <Line X1="90" Y1="180" X2="190" Y2="220" Stroke="#26FFFFFF" StrokeDashArray="3 4" />
            <Line X1="290" Y1="170" X2="190" Y2="220" Stroke="#26FFFFFF" StrokeDashArray="3 4" />
            <Line X1="90" Y1="180" X2="50" Y2="260" Stroke="#1AFFFFFF" StrokeDashArray="3 4" />
            <Line X1="290" Y1="170" X2="330" Y2="250" Stroke="#1AFFFFFF" StrokeDashArray="3 4" />
            <Line X1="190" Y1="220" X2="130" Y2="290" Stroke="#1AFFFFFF" StrokeDashArray="3 4" />
            <Line X1="190" Y1="220" X2="250" Y2="290" Stroke="#1AFFFFFF" StrokeDashArray="3 4" />

            <Ellipse Canvas.Left="152" Canvas.Top="62" Width="76" Height="76" Fill="#26009BA9" Stroke="#99009BA9" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="164" Canvas.Top="74" Width="52" Height="52" Fill="#40009BA9" Stroke="{StaticResource BrandTeal}" StrokeThickness="2" />
            <TextBlock Canvas.Left="165" Canvas.Top="88" Width="50" Text="Proyecto" TextAlignment="Center" Foreground="White" FontSize="9" FontWeight="SemiBold" />
            <TextBlock Canvas.Left="157" Canvas.Top="103" Width="66" Text="IA &amp; Educación" TextAlignment="Center" Foreground="#BFFFFFFF" FontSize="7.5" />

            <Ellipse Canvas.Left="62" Canvas.Top="152" Width="56" Height="56" Fill="#33006293" Stroke="#B3007F9D" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="72" Canvas.Top="162" Width="36" Height="36" Fill="#4D006293" Stroke="{StaticResource BrandTealDark}" StrokeThickness="1.5" />
            <TextBlock Canvas.Left="73" Canvas.Top="171" Width="34" Text="Nota" TextAlignment="Center" Foreground="White" FontSize="8" FontWeight="SemiBold" />
            <TextBlock Canvas.Left="65" Canvas.Top="183" Width="50" Text="Aprendizaje" TextAlignment="Center" Foreground="#99FFFFFF" FontSize="6.5" />

            <Ellipse Canvas.Left="262" Canvas.Top="142" Width="56" Height="56" Fill="#33003280" Stroke="#B3006293" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="272" Canvas.Top="152" Width="36" Height="36" Fill="#4D003280" Stroke="{StaticResource BrandPetroleum}" StrokeThickness="1.5" />
            <TextBlock Canvas.Left="273" Canvas.Top="161" Width="34" Text="Ref." TextAlignment="Center" Foreground="White" FontSize="8" FontWeight="SemiBold" />
            <TextBlock Canvas.Left="265" Canvas.Top="173" Width="50" Text="UNESCO 2023" TextAlignment="Center" Foreground="#99FFFFFF" FontSize="6.5" />

            <Ellipse Canvas.Left="166" Canvas.Top="196" Width="48" Height="48" Fill="#1F009BA9" Stroke="#80009BA9" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="174" Canvas.Top="204" Width="32" Height="32" Fill="#33009BA9" Stroke="#CC009BA9" StrokeThickness="1.5" />
            <TextBlock Canvas.Left="167" Canvas.Top="211" Width="46" Text="Concepto" TextAlignment="Center" Foreground="White" FontSize="7.5" FontWeight="SemiBold" />
            <TextBlock Canvas.Left="166" Canvas.Top="223" Width="48" Text="IA Adaptativa" TextAlignment="Center" Foreground="#99FFFFFF" FontSize="6" />

            <Border Canvas.Left="34" Canvas.Top="244" Width="32" Height="32" CornerRadius="16" Background="#22009BA9" BorderBrush="#88009BA9" BorderThickness="1">
              <TextBlock Text="Cita" Foreground="#CCFFFFFF" FontSize="6.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Canvas.Left="314" Canvas.Top="234" Width="32" Height="32" CornerRadius="16" Background="#22006293" BorderBrush="#88006293" BorderThickness="1">
              <TextBlock Text="Doc" Foreground="#CCFFFFFF" FontSize="6.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Canvas.Left="114" Canvas.Top="274" Width="32" Height="32" CornerRadius="16" Background="#22007F9D" BorderBrush="#88007F9D" BorderThickness="1">
              <TextBlock Text="Idea" Foreground="#CCFFFFFF" FontSize="6.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Canvas.Left="234" Canvas.Top="274" Width="32" Height="32" CornerRadius="16" Background="#22003280" BorderBrush="#88003280" BorderThickness="1">
              <TextBlock Text="Cita" Foreground="#CCFFFFFF" FontSize="6.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Canvas.Left="110" Canvas.Top="125" Width="64" Height="20" Background="#33009BA9" BorderBrush="#66009BA9" BorderThickness="1" CornerRadius="6">
              <TextBlock Text="relacionado con" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="7.5" />
            </Border>
            <Border Canvas.Left="205" Canvas.Top="130" Width="60" Height="20" Background="#33003280" BorderBrush="#66003280" BorderThickness="1" CornerRadius="6">
              <TextBlock Text="cita directa" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCFFFFFF" FontSize="7.5" />
            </Border>
          </Canvas>
        </Viewbox>

        <ItemsControl ItemsSource="{Binding Features}" Margin="38,16,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="18" Height="18" CornerRadius="9" Background="#4D009BA9" BorderBrush="#99009BA9" BorderThickness="1">
                  <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#D9FFFFFF" FontSize="13.5" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
