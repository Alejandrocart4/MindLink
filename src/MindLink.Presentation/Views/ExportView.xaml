<UserControl x:Class="MindLink.Presentation.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="820" MinHeight="520">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="FormatCardButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="MinHeight" Value="112" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Card" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#68C9D1" />
                <Setter TargetName="Card" Property="Background" Value="#F6FCFC" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandTeal}" />
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SoftTeal}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource FilterButton}">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="SummaryDivider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="#E8F0F3" />
      <Setter Property="Margin" Value="0,8" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,28,32,42">
        <TextBlock Text="Exportar documento" Style="{StaticResource PageTitle}" />

        <!-- Navegación del proceso -->
        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,12,0,25">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TextButton}" Padding="0"
                        Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepCircle" Width="27" Height="27" CornerRadius="14"
                            Background="#DCEAF0" Margin="0,0,8,0">
                      <TextBlock x:Name="StepMarker" Text="{Binding Number}" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                 FontWeight="Bold" Foreground="#91ADBB" />
                    </Border>
                    <TextBlock x:Name="StepLabel" Text="{Binding Label}" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="#8CAAB9" />
                  </StackPanel>
                </Button>
                <Border Width="45" Height="1" Margin="10,0" VerticalAlignment="Center" Background="#CEE0E7" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="StepCircle" Property="Background" Value="{StaticResource BrandTeal}" />
                  <Setter TargetName="StepMarker" Property="Foreground" Value="White" />
                  <Setter TargetName="StepLabel" Property="Foreground" Value="{StaticResource BrandTealDark}" />
                  <Setter TargetName="StepLabel" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                  <Setter TargetName="StepCircle" Property="Background" Value="{StaticResource SoftGreen}" />
                  <Setter TargetName="StepMarker" Property="Text" Value="✓" />
                  <Setter TargetName="StepMarker" Property="Foreground" Value="#2D965A" />
                  <Setter TargetName="StepLabel" Property="Foreground" Value="#4F8A6A" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>

          <!-- Paso 1: Formato -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24"
                  Visibility="{Binding IsFormatStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Seleccionar formato de exportación" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
              <ItemsControl ItemsSource="{Binding Formats}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource FormatCardButton}"
                            Command="{Binding DataContext.SelectFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                          <TextBlock Text="{Binding Icon}" FontSize="22" />
                          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#DDF5E7"
                                  CornerRadius="8" Padding="7,2" Visibility="Collapsed" x:Name="RecommendedBadge">
                            <TextBlock Text="RECOMENDADO" FontSize="8.5" FontWeight="Bold" Foreground="#27864F" />
                          </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,10,0,0">
                          <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="Bold"
                                     Foreground="{StaticResource BrandNavy}" />
                          <TextBlock Text="{Binding Description}" Margin="0,5,0,0" FontSize="11.5"
                                     Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                        <Setter TargetName="RecommendedBadge" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource PrimaryButton}" Margin="0,8,12,0" Padding="20,12"
                      Command="{Binding NextCommand}" Content="{Binding NextButtonLabel}" />
            </StackPanel>
          </Border>

          <!-- Paso 2: Opciones -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24"
                  Visibility="{Binding IsOptionsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Configurar contenido" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Define qué se incluirá en el documento exportado."
                         Margin="0,4,0,18" FontSize="12" Foreground="{StaticResource TextMuted}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Elementos del documento" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{StaticResource BrandNavy}" Margin="0,0,0,10" />
                  <CheckBox Content="Portada" IsChecked="{Binding IncludeCover}" Margin="0,0,0,9"
                            Foreground="{StaticResource TextPrimary}" />
                  <CheckBox Content="Tabla de contenido" IsChecked="{Binding IncludeTableOfContents}" Margin="0,0,0,9"
                            Foreground="{StaticResource TextPrimary}" />
                  <CheckBox Content="Bibliografía" IsChecked="{Binding IncludeBibliography}" Margin="0,0,0,9"
                            Foreground="{StaticResource TextPrimary}" />

                  <TextBlock Text="Estilo de citas" Margin="0,16,0,9" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{StaticResource BrandNavy}" />
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ChoiceButton}" Tag="{Binding IsApa}"
                            Command="{Binding SelectCitationStyleCommand}" CommandParameter="APA" Content="APA" />
                    <Button Style="{StaticResource ChoiceButton}" Tag="{Binding IsMla}"
                            Command="{Binding SelectCitationStyleCommand}" CommandParameter="MLA" Content="MLA" />
                    <Button Style="{StaticResource ChoiceButton}" Tag="{Binding IsChicago}"
                            Command="{Binding SelectCitationStyleCommand}" CommandParameter="Chicago" Content="Chicago" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Secciones" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{StaticResource BrandNavy}" Margin="0,0,0,10" />
                  <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,0,7"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.ToggleSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                          <Grid>
                            <CheckBox IsChecked="{Binding IsSelected}" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Margin="25,0,52,0" FontSize="11.5"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock HorizontalAlignment="Right" Text="Opcional" FontSize="9.5"
                                       Foreground="{StaticResource TextSubtle}" Visibility="Collapsed" x:Name="OptionalLabel" />
                          </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsOptional}" Value="True">
                            <Setter TargetName="OptionalLabel" Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>

              <Grid Margin="0,20,0,0">
                <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackCommand}" Content="←  Atrás" />
                <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="22,11"
                        Command="{Binding NextCommand}" Content="{Binding NextButtonLabel}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Paso 3: Vista previa -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24"
                  Visibility="{Binding IsPreviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="{Binding PreviewFormatLabel}" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="{Binding PreviewSectionsLabel}" Margin="0,4,0,0" FontSize="11.5"
                             Foreground="{StaticResource TextMuted}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Style="{StaticResource TagPill}" Background="{StaticResource SoftTeal}">
                  <TextBlock Text="{Binding CitationSummary}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{StaticResource BrandTealDark}" />
                </Border>
              </Grid>

              <Border Background="#EEF3F6" BorderBrush="{StaticResource Border}" BorderThickness="1"
                      CornerRadius="10" Padding="24" MinHeight="285">
                <Border Width="360" HorizontalAlignment="Center" Background="White" BorderBrush="#D7E3E8"
                        BorderThickness="1" Padding="36,28" Effect="{StaticResource CardShadow}">
                  <StackPanel>
                    <TextBlock Text="IMPACTO DE LA INTELIGENCIA ARTIFICIAL EN EL APRENDIZAJE UNIVERSITARIO"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource BrandNavy}" LineHeight="22" />
                    <Border Height="2" Background="{StaticResource PrimaryGradient}" Margin="44,16" />
                    <TextBlock Text="María Rodríguez" TextAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="Tesis de Maestría en Educación Digital" TextAlignment="Center"
                               Margin="0,4,0,22" FontSize="10.5" Foreground="{StaticResource TextSubtle}" />
                    <TextBlock Text="1. Introducción" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="9.5" LineHeight="16"
                               Foreground="{StaticResource TextMuted}"
                               Text="La inteligencia artificial está transformando los procesos de enseñanza y aprendizaje en la educación superior..." />
                  </StackPanel>
                </Border>
              </Border>

              <Grid Margin="0,18,0,0">
                <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackCommand}" Content="←  Atrás" />
                <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="22,11"
                        Command="{Binding NextCommand}" Content="{Binding NextButtonLabel}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Paso 4: Exportar -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24"
                  Visibility="{Binding IsExportStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <StackPanel>
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ExportCompleted}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Listo para exportar" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Revisa el nombre del archivo y elige dónde guardarlo."
                           Margin="0,4,0,20" FontSize="12" Foreground="{StaticResource TextMuted}" />

                <Border Background="#F8FBFD" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="18">
                  <StackPanel>
                    <TextBlock Text="Nombre del archivo" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandNavy}" Margin="0,0,0,7" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                               Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                      <Border Grid.Column="1" Background="{StaticResource SoftBlue}" CornerRadius="8"
                              Padding="12,9" Margin="8,0,0,0">
                        <TextBlock Text="{Binding SelectedFormat.Extension}" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource BrandPetroleum}" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding ExportFileName, StringFormat=Archivo final: {0}}" Margin="0,8,0,0"
                               FontSize="10.5" Foreground="{StaticResource TextSubtle}" />
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource SoftTeal}" BorderBrush="#B9E3E7" BorderThickness="1"
                        CornerRadius="10" Padding="14,11" Margin="0,14,0,0">
                  <TextBlock Text="El archivo se genera localmente. Tus notas y referencias no salen de este equipo."
                             TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrandPetroleum}" />
                </Border>

                <Grid Margin="0,20,0,0">
                  <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                          Command="{Binding BackCommand}" Content="←  Vista previa" />
                  <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="24,12"
                          Command="{Binding ExportCommand}" Content="↓  Exportar documento" />
                </Grid>
              </StackPanel>

              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ExportCompleted}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Border Width="62" Height="62" CornerRadius="31" Background="{StaticResource SoftGreen}"
                        HorizontalAlignment="Center">
                  <TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="28" FontWeight="Bold" Foreground="#2D965A" />
                </Border>
                <TextBlock Text="Documento exportado" Margin="0,16,0,0" TextAlignment="Center"
                           FontSize="21" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" />
                <TextBlock Text="{Binding LastExportFileName}" Margin="0,7,0,0" TextAlignment="Center"
                           FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrandPetroleum}" />
                <TextBlock Text="Tu documento está listo y fue guardado correctamente."
                           Margin="0,8,0,20" TextAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextMuted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Style="{StaticResource PrimaryButton}" Margin="0,0,9,0"
                          Command="{Binding OpenLocationCommand}" Content="Abrir ubicación" />
                  <Button Style="{StaticResource SecondaryButton}"
                          Command="{Binding NewExportCommand}" Content="Nueva exportación" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Resumen persistente -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Resumen de exportación" FontSize="13.5" FontWeight="Bold"
                         Foreground="{StaticResource BrandNavy}" Margin="0,0,0,14" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Proyecto" FontSize="11.5" Foreground="{StaticResource TextSubtle}" />
                <TextBlock Grid.Column="1" Text="{Binding ProjectTitle}" TextAlignment="Right" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Border Style="{StaticResource SummaryDivider}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Formato" FontSize="11.5" Foreground="{StaticResource TextSubtle}" />
                <TextBlock Grid.Column="1" Text="{Binding FormatLabel}" TextAlignment="Right" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
              </Grid>
              <Border Style="{StaticResource SummaryDivider}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Citas" FontSize="11.5" Foreground="{StaticResource TextSubtle}" />
                <TextBlock Grid.Column="1" Text="{Binding CitationSummary}" TextAlignment="Right" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
              </Grid>
              <Border Style="{StaticResource SummaryDivider}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Secciones" FontSize="11.5" Foreground="{StaticResource TextSubtle}" />
                <TextBlock Grid.Column="1" Text="{Binding IncludedSectionsLabel}" TextAlignment="Right" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
              </Grid>
              <Border Style="{StaticResource SummaryDivider}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Referencias" FontSize="11.5" Foreground="{StaticResource TextSubtle}" />
                <TextBlock Grid.Column="1" Text="{Binding ReferencesLabel}" TextAlignment="Right" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
              </Grid>
              <Border Style="{StaticResource SummaryDivider}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Páginas est." FontSize="11.5" Foreground="{StaticResource TextSubtle}" />
                <TextBlock Grid.Column="1" Text="{Binding EstimatedPagesLabel}" TextAlignment="Right" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
              </Grid>

              <Border Background="{StaticResource SoftBlue}" CornerRadius="9" Padding="12,10" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="Archivo" FontSize="9.5" Foreground="{StaticResource TextSubtle}" />
                  <TextBlock Text="{Binding ExportFileName}" Margin="0,4,0,0" FontFamily="Consolas"
                             FontSize="10.5" Foreground="{StaticResource BrandPetroleum}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Border Background="{StaticResource SoftGreen}" BorderBrush="#BFE6CE" BorderThickness="1"
                CornerRadius="9" Padding="14,9" Margin="0,14,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold"
                     Foreground="#27864F" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
