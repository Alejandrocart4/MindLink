<UserControl x:Class="MindLink.Presentation.Views.CitationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760" MinHeight="520">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <Grid Background="{StaticResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,28,32,40">
        <Grid Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Text="Gestor de citas" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding CitationSummary}" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}"
                  Padding="18,10" Command="{Binding ToggleNewCitationCommand}" Content="＋  Nueva cita" />
        </Grid>

        <Border Visibility="{Binding IsCreatingCitation, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="#80CAD1">
          <StackPanel>
            <Grid Margin="0,0,0,13">
              <StackPanel>
                <TextBlock Text="Guardar una cita" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Registra el fragmento y su procedencia; puedes clasificarlo después."
                           Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource TextMuted}" />
              </StackPanel>
              <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource TextButton}"
                      Command="{Binding CancelNewCitationCommand}" Content="Cerrar ×" />
            </Grid>
            <TextBox Style="{StaticResource InputBox}" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap"
                     Text="{Binding NewQuote, UpdateSourceTrigger=PropertyChanged}" ToolTip="Texto exacto de la cita" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Style="{StaticResource InputBox}" Margin="0,0,8,0"
                       Text="{Binding NewSource, UpdateSourceTrigger=PropertyChanged}" ToolTip="Autor, año y obra" />
              <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,0,8,0"
                       Text="{Binding NewPage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Página" />
              <TextBox Grid.Column="2" Style="{StaticResource InputBox}" Margin="0,0,10,0"
                       Text="{Binding NewContext, UpdateSourceTrigger=PropertyChanged}" ToolTip="Contexto de uso" />
              <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Command="{Binding SaveNewCitationCommand}" Content="Guardar cita" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Visibility="{Binding IsFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,14" Padding="13,9" Background="{StaticResource SoftGreen}"
                BorderBrush="#BFE6CE" BorderThickness="1" CornerRadius="9">
          <Grid>
            <TextBlock Text="{Binding FeedbackMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#27864F" />
            <Button HorizontalAlignment="Right" Style="{StaticResource TextButton}" Padding="5,1"
                    Foreground="#27864F" Command="{Binding DismissFeedbackCommand}" Content="×" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Citations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,16" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="3" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Background="{StaticResource PrimaryGradient}" />
                  <StackPanel Grid.Row="1" Margin="22,15,22,17">
                    <Grid Margin="0,0,0,13">
                      <TextBlock Text="“" FontFamily="Georgia" FontSize="34" Foreground="#72D2DB" Opacity="0.88" Margin="3,-8,0,0" />
                      <TextBlock Text="{Binding Quote}" Margin="21,0,26,0" FontSize="15" FontStyle="Italic"
                                 Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" LineHeight="25" />
                      <TextBlock Text="”" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="Georgia"
                                 FontSize="34" Foreground="#72D2DB" Opacity="0.88" Margin="0,0,4,-12" />
                    </Grid>

                    <Border Background="#F8FBFD" BorderBrush="#E8F0F3" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" MinWidth="130" />
                          <ColumnDefinition Width="Auto" MinWidth="230" />
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                          <TextBlock Text="Fuente" FontSize="10.5" Foreground="{StaticResource TextSubtle}" />
                          <TextBlock Text="{Binding Source}" Margin="0,3,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPetroleum}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                          <TextBlock Text="Obra" FontSize="10.5" Foreground="{StaticResource TextSubtle}" />
                          <TextBlock Text="{Binding Work}" Margin="0,3,0,0" FontSize="12.5" FontStyle="Italic"
                                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                          <TextBlock Text="Página" FontSize="10.5" Foreground="{StaticResource TextSubtle}" />
                          <TextBlock Text="{Binding Page}" Margin="0,3,0,0" FontSize="12.5" FontWeight="Bold"
                                     FontFamily="Consolas" Foreground="{StaticResource BrandTeal}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="Contexto de uso" FontSize="10.5" Foreground="{StaticResource TextSubtle}" />
                          <TextBlock Text="{Binding Context}" Margin="0,3,0,0" FontSize="12.5"
                                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Nota vinculada:" FontSize="11.5" Foreground="{StaticResource TextSubtle}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource TagPill}" Margin="8,0,0,0" Padding="8,3" Background="{StaticResource SoftBlue}">
                          <TextBlock Text="{Binding LinkedNote, StringFormat=▤  {0}}" FontSize="11.5" Foreground="{StaticResource BrandPetroleum}" />
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="0,0,8,0" FontSize="11.5"
                                Foreground="{StaticResource TextMuted}" Content="▱  Copiar APA"
                                Command="{Binding DataContext.CopyApaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource SecondaryButton}" Padding="11,6" FontSize="11.5"
                                Foreground="{StaticResource BrandTealDark}" BorderBrush="#78CED5" Content="↓  Insertar en doc"
                                Command="{Binding DataContext.InsertIntoDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,10,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource TagPill}" Margin="0,0,6,0" Padding="8,3">
                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
