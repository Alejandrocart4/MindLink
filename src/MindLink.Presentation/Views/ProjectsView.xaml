<UserControl x:Class="MindLink.Presentation.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MindLink.Presentation.ViewModels"
             Background="{DynamicResource AppBackground}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="ProjectStatusPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="{StaticResource SoftBlue}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Idea"><Setter Property="Background" Value="#F1F6F8" /></Trigger>
        <Trigger Property="Tag" Value="Investigación"><Setter Property="Background" Value="#EAF4F7" /></Trigger>
        <Trigger Property="Tag" Value="Redacción"><Setter Property="Background" Value="{StaticResource SoftTeal}" /></Trigger>
        <Trigger Property="Tag" Value="Revisión"><Setter Property="Background" Value="{StaticResource SoftAmber}" /></Trigger>
        <Trigger Property="Tag" Value="Finalizado"><Setter Property="Background" Value="{StaticResource SoftGreen}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ProjectStatusText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource BrandPetroleum}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Idea"><Setter Property="Foreground" Value="#91ACB9" /></Trigger>
        <Trigger Property="Tag" Value="Investigación"><Setter Property="Foreground" Value="{StaticResource BrandPetroleum}" /></Trigger>
        <Trigger Property="Tag" Value="Redacción"><Setter Property="Foreground" Value="{StaticResource BrandTealDark}" /></Trigger>
        <Trigger Property="Tag" Value="Revisión"><Setter Property="Foreground" Value="#A77811" /></Trigger>
        <Trigger Property="Tag" Value="Finalizado"><Setter Property="Foreground" Value="{StaticResource Success}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CleanListBoxItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28,32,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Proyectos de investigación" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding CreateProjectCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="＋" Foreground="White" FontSize="16" Margin="0,-2,7,0" />
            <TextBlock Text="Nuevo proyecto" Foreground="White" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectFilterOption}">
              <Button Content="{Binding Label}"
                      Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Label}"
                      Tag="{Binding IsSelected}"
                      Style="{StaticResource FilterButton}"
                      Margin="0,0,7,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Column="2" Margin="12,0,12,0">
          <TextBox x:Name="ProjectSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource InputBox}" Padding="32,7,10,7" />
          <TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource TextSubtle}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,2"
                     IsHitTestVisible="False" />
          <TextBlock Text="Buscar proyectos..." FontSize="12.5" Foreground="{StaticResource TextSubtle}"
                     Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=ProjectSearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Border Grid.Column="3" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Background="White">
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding ShowCardsCommand}" Style="{StaticResource TextButton}" Padding="11,8" ToolTip="Vista de tarjetas">
              <TextBlock Text="▦" FontSize="16">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsCardView}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrandBlue}" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button>
            <Border Width="1" Background="{StaticResource Border}" />
            <Button Command="{Binding ShowListCommand}" Style="{StaticResource TextButton}" Padding="11,8" ToolTip="Vista de lista">
              <TextBlock Text="☷" FontSize="16">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsListView}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrandBlue}" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Margin="0,0,0,14" Background="{StaticResource SoftTeal}" BorderBrush="#B9E3E6"
              BorderThickness="1" CornerRadius="8" Padding="12,8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding HasStatusMessage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource BrandTealDark}" />
      </Border>

      <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding VisibleProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CleanListBoxItem}"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Style>
            <Style TargetType="ListBox">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding IsCardView}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
          </ListBox.Style>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
              <Border Width="365" MinHeight="260" Margin="0,0,16,16" Padding="20,18" Background="White" CornerRadius="14">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrandTeal}" />
                        <Setter Property="BorderThickness" Value="2" />
                      </DataTrigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#9FD8DD" /></Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Border Style="{StaticResource ProjectStatusPill}" Tag="{Binding Status}" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Status}" Tag="{Binding Status}" Style="{StaticResource ProjectStatusText}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding CollaboratorInitials}" HorizontalAlignment="Right">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="25" Height="25" Margin="-6,0,0,0" CornerRadius="13" Background="{StaticResource PrimaryGradient}"
                                  BorderBrush="White" BorderThickness="2">
                            <TextBlock Text="{Binding}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>

                  <TextBlock Grid.Row="1" Text="{Binding Title}" FontFamily="Segoe UI Variable Display" FontSize="14"
                             FontWeight="Bold" Foreground="{StaticResource BrandNavy}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                             TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,14" />
                  <ProgressBar Grid.Row="3" Style="{StaticResource MindLinkProgress}" Value="{Binding Progress}" Maximum="100" Margin="0,0,0,10" />

                  <ItemsControl Grid.Row="4" ItemsSource="{Binding Tags}" Margin="0,0,0,13">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource TagPill}" Margin="0,0,6,4">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◇" FontSize="10" Foreground="{StaticResource BrandPetroleum}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource BrandPetroleum}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Grid Grid.Row="5" Margin="0,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="#EEF4F7" />
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NotesCount, StringFormat={}{0} notas}" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding ReferencesCount, StringFormat={}{0} refs}" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" FontSize="11.5" Foreground="{StaticResource TextSubtle}" />
                      </StackPanel>
                      <TextBlock Text="{Binding UpdatedLabel}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSubtle}" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border>
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding IsListView}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <Grid Background="#F8FBFD" Height="46">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width=".7*" /><ColumnDefinition Width=".9*" /><ColumnDefinition Width="1.1*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Proyecto" Margin="16,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <TextBlock Grid.Column="1" Text="Estado" Margin="12,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <TextBlock Grid.Column="2" Text="Progreso" Margin="12,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <TextBlock Grid.Column="3" Text="Notas" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <TextBlock Grid.Column="4" Text="Referencias" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
              <TextBlock Grid.Column="5" Text="Modificado" Margin="12,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
            </Grid>
            <ListBox ItemsSource="{Binding VisibleProjects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CleanListBoxItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#EEF4F7" BorderThickness="0,1,0,0" Padding="0,13">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width=".7*" /><ColumnDefinition Width=".9*" /><ColumnDefinition Width="1.1*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="16,0">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                      </StackPanel>
                      <Border Grid.Column="1" Style="{StaticResource ProjectStatusPill}" Tag="{Binding Status}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding Status}" Tag="{Binding Status}" Style="{StaticResource ProjectStatusText}" />
                      </Border>
                      <Grid Grid.Column="2" Margin="12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource MindLinkProgress}" Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                      </Grid>
                      <TextBlock Grid.Column="3" Text="{Binding NotesCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}" />
                      <TextBlock Grid.Column="4" Text="{Binding ReferencesCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}" />
                      <TextBlock Grid.Column="5" Text="{Binding UpdatedLabel}" Margin="12,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSubtle}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
