<UserControl x:Class="MindLink.Presentation.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MindLink.Presentation.ViewModels"
             Background="{DynamicResource AppBackground}">
  <UserControl.Resources>
    <Style x:Key="CleanNoteItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NoteStatusBorder" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Background" Value="{StaticResource SoftGreen}" />
      <Style.Triggers><Trigger Property="Tag" Value="Borrador"><Setter Property="Background" Value="{StaticResource SoftAmber}" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NoteStatusText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Success}" />
      <Style.Triggers><Trigger Property="Tag" Value="Borrador"><Setter Property="Foreground" Value="#D18A13" /></Trigger></Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28,32,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Notas de investigación" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource TextMuted}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Grid Width="235" Margin="0,0,10,0">
            <TextBox x:Name="NoteSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Padding="32,7,10,7" />
            <TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource TextSubtle}" Margin="11,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock Text="Buscar notas..." FontSize="12.5" Foreground="{StaticResource TextSubtle}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NoteSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Background="White" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding ShowCardsCommand}" Style="{StaticResource TextButton}" Padding="11,8" ToolTip="Vista de tarjetas">
                <TextBlock Text="▦" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSubtle}" /><Style.Triggers><DataTrigger Binding="{Binding IsCardView}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrandBlue}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Button>
              <Border Width="1" Background="{StaticResource Border}" />
              <Button Command="{Binding ShowListCommand}" Style="{StaticResource TextButton}" Padding="11,8" ToolTip="Vista de lista">
                <TextBlock Text="☷" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSubtle}" /><Style.Triggers><DataTrigger Binding="{Binding IsListView}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrandBlue}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Button>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateNoteCommand}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="White" FontSize="16" Margin="0,-2,7,0" /><TextBlock Text="Nueva nota" Foreground="White" FontWeight="SemiBold" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}" Margin="0,0,0,14">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:NoteFilterOption}">
            <Button Content="{Binding Label}" Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Label}" Tag="{Binding IsSelected}" Style="{StaticResource FilterButton}" Margin="0,0,7,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Row="2" Margin="0,0,0,14" Background="{StaticResource SoftTeal}" BorderBrush="#B9E3E6" BorderThickness="1" CornerRadius="8" Padding="12,8">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasStatusMessage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource BrandTealDark}" />
      </Border>

      <Grid Grid.Row="3">
        <ListBox ItemsSource="{Binding VisibleNotes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource CleanNoteItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsCardView}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="300" MinHeight="278" Margin="0,0,14,14" Padding="18,16" CornerRadius="12" Background="White">
                <Border.Style>
                  <Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Border}" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource BrandTeal}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#9FD8DD" /></Trigger></Style.Triggers></Style>
                </Border.Style>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Variable Display" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,9,0" />
                    <Border Grid.Column="1" Style="{StaticResource NoteStatusBorder}" Tag="{Binding Status}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Status}" Tag="{Binding Status}" Style="{StaticResource NoteStatusText}" />
                    </Border>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="{Binding Excerpt}" FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,12" />
                  <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource TagPill}" Margin="0,0,5,5"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="10" Foreground="{StaticResource BrandPetroleum}" Margin="0,0,4,0" /><TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource BrandPetroleum}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Grid.Row="3">
                    <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="#EEF4F7" />
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ReferencesCount, StringFormat={}{0} refs}" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,0,12,0" /><TextBlock Text="{Binding ConnectionsCount, StringFormat={}{0} vínculos}" FontSize="11.5" Foreground="{StaticResource TextSubtle}" /></StackPanel>
                      <TextBlock Text="{Binding UpdatedLabel}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSubtle}" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ListBox ItemsSource="{Binding VisibleNotes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CleanNoteItem}" Visibility="Collapsed">
          <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsListView}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CompactCard}" Margin="0,0,0,10" Padding="18,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrandNavy}" TextWrapping="Wrap" Margin="0,0,16,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Excerpt}" FontSize="12.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" VerticalAlignment="Center" />
                  <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource TagPill}" Margin="0,0,5,4"><TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource BrandPetroleum}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding ReferencesCount, StringFormat={}{0} refs}" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,0,8,0" /><TextBlock Text="{Binding ConnectionsCount, StringFormat={}{0} vínc.}" FontSize="11.5" Foreground="{StaticResource TextSubtle}" /></StackPanel>
                  <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Style="{StaticResource NoteStatusBorder}" Tag="{Binding Status}" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Tag="{Binding Status}" Style="{StaticResource NoteStatusText}" /></Border><TextBlock Text="{Binding UpdatedLabel}" FontSize="10.5" Foreground="{StaticResource TextSubtle}" Margin="0,6,0,0" HorizontalAlignment="Right" /></StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
