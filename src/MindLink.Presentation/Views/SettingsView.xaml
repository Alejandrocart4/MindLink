<UserControl x:Class="MindLink.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MindLink.Presentation.Controls"
             xmlns:vm="clr-namespace:MindLink.Presentation.ViewModels"
             Background="{DynamicResource AppBackground}"
             MinWidth="780"
             MinHeight="520">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="SettingsNavigationButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftBlue}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource SoftTeal}" />
          <Setter Property="BorderBrush" Value="{StaticResource BrandTeal}" />
          <Setter Property="Foreground" Value="{StaticResource BrandTeal}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="24,20" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="ChoiceCardButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#80C7CE" />
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftTeal}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Tag" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource BrandTeal}" />
          <Setter Property="Background" Value="{DynamicResource SoftTeal}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ChoiceChipButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#80C7CE" />
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftTeal}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Tag" Value="True">
          <Setter Property="Background" Value="{DynamicResource SoftTeal}" />
          <Setter Property="BorderBrush" Value="{StaticResource BrandTeal}" />
          <Setter Property="Foreground" Value="{StaticResource BrandTealDark}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="24">
              <Border x:Name="Track" Background="#C9D9E1" CornerRadius="12" />
              <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3"
                       Fill="White" HorizontalAlignment="Left">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.22" />
                </Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandTeal}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingRow" TargetType="Border">
      <Setter Property="Padding" Value="0,14" />
      <Setter Property="BorderBrush" Value="#EEF4F7" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navegación secundaria, idéntica a la estructura del prototipo. -->
    <Border Grid.Column="0"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,1,0"
            Padding="8,16">
      <StackPanel>
        <TextBlock Text="CONFIGURACIÓN"
                   Margin="10,0,0,8"
                   Foreground="#9AB0BF"
                   FontSize="11"
                   FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsSectionItemViewModel}">
              <Button Content="{Binding Label}"
                      Style="{StaticResource SettingsNavigationButton}"
                      Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="36,28,36,40">
        <!-- APARIENCIA -->
        <StackPanel Visibility="{Binding IsAppearanceSection, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Apariencia"
                     Margin="0,0,0,20"
                     FontFamily="Segoe UI Variable Display"
                     FontSize="20"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimary}" />

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Tema de color"
                         Margin="0,0,0,16"
                         FontSize="14"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimary}" />
              <UniformGrid Columns="2">
                <Button Margin="0,0,7,0"
                        Tag="{Binding IsLightTheme}"
                        Style="{StaticResource ChoiceCardButton}"
                        Command="{Binding SelectThemeCommand}"
                        CommandParameter="Claro">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Border Width="20" Height="20" Margin="0,0,6,0" Background="#F4F8FA" BorderBrush="#EEF4F7" BorderThickness="1" CornerRadius="5" />
                      <Border Width="20" Height="20" Margin="0,0,6,0" Background="#FFFFFF" BorderBrush="#EEF4F7" BorderThickness="1" CornerRadius="5" />
                      <Border Width="20" Height="20" Background="#01153E" BorderBrush="#EEF4F7" BorderThickness="1" CornerRadius="5" />
                    </StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☼" Margin="0,-1,8,0" FontSize="17" Foreground="{StaticResource BrandTeal}" />
                        <TextBlock Text="Claro" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrandPetroleum}" />
                      </StackPanel>
                      <Border Width="16" Height="16" HorizontalAlignment="Right" CornerRadius="8"
                              Background="{StaticResource BrandTeal}"
                              Visibility="{Binding IsLightTheme, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White" />
                      </Border>
                    </Grid>
                  </StackPanel>
                </Button>

                <Button Margin="7,0,0,0"
                        Tag="{Binding IsDarkTheme}"
                        Style="{StaticResource ChoiceCardButton}"
                        Command="{Binding SelectThemeCommand}"
                        CommandParameter="Oscuro">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Border Width="20" Height="20" Margin="0,0,6,0" Background="#0E1B2E" BorderBrush="#2B425A" BorderThickness="1" CornerRadius="5" />
                      <Border Width="20" Height="20" Margin="0,0,6,0" Background="#162032" BorderBrush="#2B425A" BorderThickness="1" CornerRadius="5" />
                      <Border Width="20" Height="20" Background="#FFFFFF" BorderBrush="#EEF4F7" BorderThickness="1" CornerRadius="5" />
                    </StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☾" Margin="0,-1,8,0" FontSize="17" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="Oscuro" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                      </StackPanel>
                      <Border Width="16" Height="16" HorizontalAlignment="Right" CornerRadius="8"
                              Background="{StaticResource BrandTeal}"
                              Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White" />
                      </Border>
                    </Grid>
                  </StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Tipografía" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
              <TextBlock Text="Tamaño de fuente en el editor" Margin="0,4,0,14" FontSize="12.5" Foreground="{DynamicResource TextSubtle}" />
              <ItemsControl ItemsSource="{Binding FontSizes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:EditorFontSizeItemViewModel}">
                    <Button Content="{Binding Label}"
                            Tag="{Binding IsSelected}"
                            Style="{StaticResource ChoiceChipButton}"
                            Command="{Binding DataContext.SelectFontSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ALMACENAMIENTO -->
        <StackPanel Visibility="{Binding IsStorageSection, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Almacenamiento y copias de seguridad"
                     Margin="0,0,0,20" FontFamily="Segoe UI Variable Display" FontSize="20"
                     FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Almacenamiento local" FontSize="14" FontWeight="Bold" />
                  <TextBlock Text="Gratuito · Sin límite" Margin="0,3,0,0" FontSize="12.5" Foreground="{DynamicResource TextSubtle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,3"
                        CornerRadius="10" Background="{DynamicResource SoftGreen}">
                  <TextBlock Text="Activo" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}" />
                </Border>
              </Grid>
              <Grid Margin="0,2,0,12">
                <TextBlock Text="Usado" FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Text="{Binding StorageUsage}" HorizontalAlignment="Right" FontFamily="Consolas"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
              </Grid>
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Ubicación:  " FontSize="12.5" Foreground="{DynamicResource TextMuted}" />
                  <TextBlock Text="{Binding StorageLocation}" FontFamily="Consolas" FontSize="12.5"
                             Foreground="{StaticResource BrandPetroleum}" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="12,7"
                        Command="{Binding OpenStorageFolderCommand}" Content="Abrir carpeta" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Margin="0,0,0,16" Padding="24,20" CornerRadius="14" Background="{StaticResource WelcomeGradient}" ClipToBounds="True">
            <Grid>
              <Ellipse Width="150" Height="150" Margin="0,-70,-55,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#16009BA9" />
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="⌁" Margin="0,-2,8,0" FontSize="21" Foreground="{StaticResource BrandTeal}" />
                      <TextBlock Text="Sincronización cifrada en la nube" FontSize="14" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                    <TextBlock Text="Respaldo automático · Acceso desde cualquier dispositivo" Margin="29,3,0,0" FontSize="12.5" Foreground="#A8B9CD" />
                  </StackPanel>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,3" CornerRadius="11"
                          Background="#30009BA9" BorderBrush="#66009BA9" BorderThickness="1">
                    <TextBlock Text="PRO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" />
                  </Border>
                </Grid>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="✓  Sincronización cifrada de extremo a extremo" Margin="0,0,0,5" FontSize="12.5" Foreground="#C5D2E0" />
                  <TextBlock Text="✓  Respaldo automático cada 15 minutos" Margin="0,0,0,5" FontSize="12.5" Foreground="#C5D2E0" />
                  <TextBlock Text="✓  Colaboración con hasta 5 investigadores" Margin="0,0,0,5" FontSize="12.5" Foreground="#C5D2E0" />
                  <TextBlock Text="✓  Acceso desde múltiples dispositivos" FontSize="12.5" Foreground="#C5D2E0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Padding="20,9" Command="{Binding ActivateCloudSyncCommand}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Content" Value="Activar sincronización — $4.99/mes" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CloudSyncRequested}" Value="True">
                            <Setter Property="Content" Value="Solicitud registrada ✓" />
                            <Setter Property="IsEnabled" Value="False" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <TextBlock Text="Te notificaremos cuando esté disponible."
                             Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#A8B9CD"
                             Visibility="{Binding CloudSyncRequested, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- PRIVACIDAD -->
        <StackPanel Visibility="{Binding IsPrivacySection, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Privacidad"
                     Margin="0,0,0,6" FontFamily="Segoe UI Variable Display" FontSize="20"
                     FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Text="Controla cómo MindLink protege y utiliza tus datos locales."
                     Margin="0,0,0,20" FontSize="13" Foreground="{DynamicResource TextMuted}" />
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <Border Style="{StaticResource SettingRow}">
                <Grid>
                  <StackPanel Margin="0,0,70,0">
                    <TextBlock Text="Cifrar archivos locales" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="Protege proyectos, notas y referencias almacenados en este equipo."
                               Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"
                            IsChecked="{Binding EncryptLocalFiles, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRow}">
                <Grid>
                  <StackPanel Margin="0,0,70,0">
                    <TextBlock Text="Confirmar antes de eliminar" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="Solicita confirmación antes de borrar contenido importante."
                               Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"
                            IsChecked="{Binding ConfirmBeforeDeleting, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Padding="0,14,0,2">
                <Grid>
                  <StackPanel Margin="0,0,70,0">
                    <TextBlock Text="Compartir diagnósticos anónimos" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="Envía solo información técnica sin incluir textos, fuentes ni datos personales."
                               Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"
                            IsChecked="{Binding AllowUsageDiagnostics, Mode=TwoWay}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Padding="16,13" Background="{DynamicResource SoftGreen}" BorderBrush="#BFE6CE" BorderThickness="1" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="✓" Margin="0,0,10,0" FontSize="15" Foreground="{StaticResource Success}" />
              <TextBlock Text="Tus proyectos permanecen en este equipo. MindLink funciona sin servidores externos obligatorios."
                         FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- CITAS Y FORMATO -->
        <StackPanel Visibility="{Binding IsCitationsSection, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Citas y formato"
                     Margin="0,0,0,6" FontFamily="Segoe UI Variable Display" FontSize="20"
                     FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Text="Elige el estilo bibliográfico predeterminado para documentos y exportaciones."
                     Margin="0,0,0,20" FontSize="13" Foreground="{DynamicResource TextMuted}" />
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Estilo predeterminado" Margin="0,0,0,14" FontSize="14" FontWeight="Bold" />
              <UniformGrid Columns="3">
                <Button Margin="0,0,7,0" Tag="{Binding IsApa}" Style="{StaticResource ChoiceCardButton}"
                        Command="{Binding SelectCitationStyleCommand}" CommandParameter="APA">
                  <StackPanel>
                    <TextBlock Text="APA" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandPetroleum}" />
                    <TextBlock Text="7.ª edición" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}" />
                  </StackPanel>
                </Button>
                <Button Margin="7,0" Tag="{Binding IsMla}" Style="{StaticResource ChoiceCardButton}"
                        Command="{Binding SelectCitationStyleCommand}" CommandParameter="MLA">
                  <StackPanel>
                    <TextBlock Text="MLA" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandPetroleum}" />
                    <TextBlock Text="9.ª edición" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}" />
                  </StackPanel>
                </Button>
                <Button Margin="7,0,0,0" Tag="{Binding IsChicago}" Style="{StaticResource ChoiceCardButton}"
                        Command="{Binding SelectCitationStyleCommand}" CommandParameter="Chicago">
                  <StackPanel>
                    <TextBlock Text="Chicago" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrandPetroleum}" />
                    <TextBlock Text="17.ª edición" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}" />
                  </StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingsCard}">
            <Grid>
              <StackPanel>
                <TextBlock Text="Formato activo" FontSize="12" Foreground="{DynamicResource TextSubtle}" />
                <TextBlock Text="{Binding DefaultCitationStyle}" Margin="0,5,0,0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandTealDark}" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="Se aplicará a" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextSubtle}" />
                <TextBlock Text="Citas, bibliografía y exportaciones" Margin="0,5,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ATAJOS -->
        <StackPanel Visibility="{Binding IsShortcutsSection, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Atajos de teclado"
                     Margin="0,0,0,20" FontFamily="Segoe UI Variable Display" FontSize="20"
                     FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Shortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:KeyboardShortcutItemViewModel}">
                  <Border Padding="20,12" BorderBrush="#F0F6FA" BorderThickness="0,0,0,1">
                    <Grid>
                      <TextBlock Text="{Binding Action}" VerticalAlignment="Center" FontSize="13.5" Foreground="{DynamicResource TextPrimary}" />
                      <Border HorizontalAlignment="Right" Padding="9,4" Background="{DynamicResource SoftBlue}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="1.5,1.5,1.5,2.5" CornerRadius="6">
                        <TextBlock Text="{Binding Shortcut}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandPetroleum}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- ACERCA DE -->
        <StackPanel Visibility="{Binding IsAboutSection, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Acerca de MindLink"
                     Margin="0,0,0,20" FontFamily="Segoe UI Variable Display" FontSize="20"
                     FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
          <Border Style="{StaticResource SettingsCard}" Padding="32,28">
            <StackPanel HorizontalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <controls:MindLinkBrand Size="44" />
                <TextBlock Text="MindLink" Margin="12,0,0,0" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource BrandBlue}" />
              </StackPanel>
              <TextBlock Text="MindLink v1.4.2" Margin="0,16,0,4" HorizontalAlignment="Center"
                         FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" />
              <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontSize="13.5"
                         Foreground="{DynamicResource TextMuted}" LineHeight="22" TextWrapping="Wrap">
                <Run Text="Un espacio de trabajo local que transforma investigaciones fragmentadas" />
                <LineBreak />
                <Run Text="en conocimiento estructurado y narrativas publicables." />
              </TextBlock>
              <Border Width="360" Height="1" Margin="0,22,0,18" Background="{DynamicResource Border}" />
              <TextBlock Text="{Binding UserName}" HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Text="{Binding UserRole}" Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMuted}" />
              <TextBlock Text="© 2026 MindLink · Todos los datos permanecen bajo tu control."
                         Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSubtle}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
