<UserControl x:Class="MindLink.Presentation.Views.ReferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MindLink.Presentation.ViewModels"
             MinWidth="760"
             MinHeight="520"
             Background="{DynamicResource AppBackground}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="SegmentButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#F0F6FA" />
                <Setter Property="Foreground" Value="{StaticResource BrandBlue}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SoftBlue}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ReferenceRowButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#F8FBFD" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#EDF8F8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ReferenceActionButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="BorderBrush" Value="#E8F0F3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource SoftTeal}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#9BD9DE" />
                <Setter Property="Foreground" Value="{StaticResource BrandTealDark}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ReferenceTypePill" TargetType="Border">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="#EEF4F7" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Libro"><Setter Property="Background" Value="#EEF2F8" /></Trigger>
        <Trigger Property="Tag" Value="Informe institucional"><Setter Property="Background" Value="#EAF7F8" /></Trigger>
        <Trigger Property="Tag" Value="Artículo científico"><Setter Property="Background" Value="#EDF5F8" /></Trigger>
        <Trigger Property="Tag" Value="Revisión sistemática"><Setter Property="Background" Value="#E9F8F9" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReferenceTypeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Libro"><Setter Property="Foreground" Value="{StaticResource BrandBlue}" /></Trigger>
        <Trigger Property="Tag" Value="Informe institucional"><Setter Property="Foreground" Value="{StaticResource BrandTealDark}" /></Trigger>
        <Trigger Property="Tag" Value="Artículo científico"><Setter Property="Foreground" Value="{StaticResource BrandPetroleum}" /></Trigger>
        <Trigger Property="Tag" Value="Revisión sistemática"><Setter Property="Foreground" Value="{StaticResource BrandTeal}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadingStatusPill" TargetType="Border">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="#F2F6F8" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Leído"><Setter Property="Background" Value="{StaticResource SoftGreen}" /></Trigger>
        <Trigger Property="Tag" Value="En lectura"><Setter Property="Background" Value="{StaticResource SoftAmber}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadingStatusText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Leído"><Setter Property="Foreground" Value="{StaticResource Success}" /></Trigger>
        <Trigger Property="Tag" Value="En lectura"><Setter Property="Foreground" Value="#D48A0B" /></Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Encabezado -->
    <Border Grid.Row="0" Padding="28,20" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Referencias bibliográficas" Style="{StaticResource PageTitle}" FontSize="20" />
          <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource TextMuted}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Margin="0,0,8,0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Formats}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CitationFormatOption}">
                  <Button Content="{Binding Label}" Tag="{Binding IsSelected}" Style="{StaticResource SegmentButton}"
                          Command="{Binding DataContext.SetFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Label}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <Button Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"
                  Command="{Binding ImportReferenceCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="↥" FontSize="15" Margin="0,-2,6,0" Foreground="{StaticResource TextMuted}" />
              <TextBlock Text="Importar" FontSize="12.5" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
          </Button>

          <Button Style="{StaticResource PrimaryButton}" Padding="16,9" Command="{Binding CreateReferenceCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="＋" FontSize="16" Margin="0,-2,6,0" Foreground="White" />
              <TextBlock Text="Nueva referencia" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Búsqueda y controles -->
    <Border Grid.Row="1" Padding="28,12" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid>
          <TextBox x:Name="ReferenceSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource InputBox}" Padding="32,7,10,7" />
          <TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource TextSubtle}" Margin="11,0,0,2"
                     HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBlock Text="Buscar por autor, título, DOI…" FontSize="12.5" Foreground="{StaticResource TextSubtle}"
                     Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=ReferenceSearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="12,0,0,0"
                Command="{Binding ToggleFiltersCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="▽" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
            <TextBlock Text="Filtros" FontSize="12.5" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
        </Button>

        <Border Grid.Column="3" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SegmentButton}" Tag="{Binding IsTableView}" Padding="11,7"
                    Command="{Binding ShowTableCommand}" ToolTip="Vista de tabla">
              <TextBlock Text="☷" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Border Width="1" Background="{StaticResource Border}" />
            <Button Style="{StaticResource SegmentButton}" Tag="{Binding IsCardView}" Padding="11,7"
                    Command="{Binding ShowCardsCommand}" ToolTip="Vista de tarjetas">
              <TextBlock Text="▦" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Panel de filtros -->
    <Border Grid.Row="2" Padding="28,10" Background="#FBFDFE" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
            Visibility="{Binding AreFiltersVisible, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <TextBlock Text="Estado de lectura" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                   VerticalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding Filters}" Margin="112,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ReferenceFilterOption}">
              <Button Content="{Binding Label}" Tag="{Binding IsSelected}" Style="{StaticResource FilterButton}"
                      Padding="12,6" Margin="0,0,7,0"
                      Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- Alertas y confirmaciones -->
    <StackPanel Grid.Row="3" Margin="28,10,28,10">
      <StackPanel Orientation="Horizontal">
        <Border Background="#FFF7F5" BorderBrush="#F3C7C1" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠" FontSize="14" Foreground="{StaticResource Danger}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding IncompleteReferencesLabel}" FontSize="12" Foreground="#C0392B" />
          </StackPanel>
        </Border>
        <Border Background="#FFF9ED" BorderBrush="#ECD9AC" BorderThickness="1" CornerRadius="8" Padding="12,7">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="ⓘ" FontSize="14" Foreground="#A77811" Margin="0,0,8,0" />
            <TextBlock Text="{Binding UnclassifiedReferencesLabel}" FontSize="12" Foreground="#916E10" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Margin="0,9,0,0" Padding="12,8" Background="{StaticResource SoftGreen}" BorderBrush="#BFE6CE"
              BorderThickness="1" CornerRadius="8"
              Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#27864F" />
      </Border>
    </StackPanel>

    <!-- Resultados -->
    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,0,28,28">
        <!-- Vista de tabla -->
        <StackPanel Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibility}}">
          <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
            <StackPanel>
              <Border Padding="14,11" Background="#F8FBFD" BorderBrush="#EEF4F7" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1" Text="Autores" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Column="2" Text="Año" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Column="3" Text="Título" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Column="4" Text="Tipo" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Column="5" Text="Estado" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Grid.Column="6" Text="Usos" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                </Grid>
              </Border>

              <ItemsControl ItemsSource="{Binding VisibleReferences}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                      </Grid.RowDefinitions>
                      <Button Grid.Row="0" Style="{StaticResource ReferenceRowButton}" Command="{Binding DataContext.SelectReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Grid Margin="14,11">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="70" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="!" FontSize="14" Foreground="{StaticResource Danger}" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsComplete}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <TextBlock Grid.Column="1" Text="{Binding Authors}" Margin="0,0,12,0" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Year}" FontSize="12.5" FontFamily="Consolas"
                                     Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />

                          <StackPanel Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Style="{StaticResource TagPill}" Padding="8,2" Margin="0,0,5,0" Background="#F0F6FA">
                                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource BrandPetroleum}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <Border Grid.Column="4" Tag="{Binding ReferenceType}" Style="{StaticResource ReferenceTypePill}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReferenceType}" Tag="{Binding ReferenceType}" Style="{StaticResource ReferenceTypeText}" />
                          </Border>

                          <Border Grid.Column="5" Tag="{Binding ReadingStatus}" Style="{StaticResource ReadingStatusPill}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReadingStatus}" Tag="{Binding ReadingStatus}" Style="{StaticResource ReadingStatusText}" />
                          </Border>

                          <TextBlock Grid.Column="6" Text="{Binding UsageCount}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                          <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ReferenceActionButton}" Margin="0,0,5,0" Content="▣" ToolTip="Copiar cita"
                                    Command="{Binding DataContext.CopyCitationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource ReferenceActionButton}" Content="↗" ToolTip="Abrir fuente"
                                    Command="{Binding DataContext.OpenExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      <Border Grid.Row="1" Background="#F0F6FA" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Vista de tarjetas -->
        <ItemsControl ItemsSource="{Binding VisibleReferences}" Visibility="{Binding IsCardView, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Width="390" MinHeight="235" Margin="0,0,16,16" Style="{StaticResource ReferenceRowButton}"
                      Command="{Binding DataContext.SelectReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <Border Style="{StaticResource Card}" Padding="18" Width="390">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                      <Border Tag="{Binding ReferenceType}" Style="{StaticResource ReferenceTypePill}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ReferenceType}" Tag="{Binding ReferenceType}" Style="{StaticResource ReferenceTypeText}" />
                      </Border>
                      <TextBlock Text="Referencia incompleta" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Danger}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsComplete}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontFamily="Segoe UI Variable Display" FontSize="14"
                               FontWeight="Bold" Foreground="{StaticResource BrandNavy}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8" />
                    <StackPanel Grid.Row="2">
                      <TextBlock Text="{Binding Authors}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                      <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextMuted}">
                        <Run Text="{Binding Source, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Year, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Identifier}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource BrandPetroleum}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Tags}" Margin="0,12,0,12">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource TagPill}" Padding="8,2" Margin="0,0,5,4">
                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource BrandPetroleum}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="4">
                      <StackPanel Orientation="Horizontal">
                        <Border Tag="{Binding ReadingStatus}" Style="{StaticResource ReadingStatusPill}" Margin="0,0,10,0">
                          <TextBlock Text="{Binding ReadingStatus}" Tag="{Binding ReadingStatus}" Style="{StaticResource ReadingStatusText}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSubtle}">
                          <Run Text="{Binding UsageCount, Mode=OneWay}" /><Run Text=" usos" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ReferenceActionButton}" Margin="0,0,5,0" Content="▣" ToolTip="Copiar cita"
                                Command="{Binding DataContext.CopyCitationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource ReferenceActionButton}" Content="↗" ToolTip="Abrir fuente"
                                Command="{Binding DataContext.OpenExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Generador de cita para la referencia elegida -->
        <Border Margin="0,16,0,0" Padding="20,17" Background="White" BorderBrush="#8ED3D9" BorderThickness="1"
                CornerRadius="14" Visibility="{Binding HasSelectedReference, Converter={StaticResource BoolToVisibility}}"
                VerticalAlignment="Bottom">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="GENERADOR DE CITA · " FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandPetroleum}" />
                <TextBlock Text="{Binding SelectedFormat}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandPetroleum}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0"
                        Command="{Binding CopyCitationCommand}" CommandParameter="{Binding SelectedReference}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▣" Margin="0,0,5,0" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="Copiar" FontSize="12" Foreground="{StaticResource TextMuted}" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="10,6" BorderBrush="#8ED3D9"
                        Background="{StaticResource SoftTeal}" Command="{Binding InsertCitationCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↳" Margin="0,0,5,0" Foreground="{StaticResource BrandTealDark}" />
                    <TextBlock Text="Insertar en el documento" FontSize="12" Foreground="{StaticResource BrandTealDark}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Border Background="#F8FBFD" BorderBrush="#EEF4F7" BorderThickness="1" CornerRadius="8" Padding="14,11">
              <TextBlock Text="{Binding SelectedCitation}" FontSize="13.5" Foreground="{StaticResource TextPrimary}"
                         TextWrapping="Wrap" LineHeight="23" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
