<UserControl x:Class="MindLink.Presentation.Views.WorkspaceShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MindLink.Presentation.Controls"
             Background="{StaticResource AppBackground}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <Style x:Key="SidebarNavigationButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#9AB4C2" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="0,10,10,0"
                    Margin="8,0,8,0">
              <Grid>
                <Border x:Name="Accent" Width="3" CornerRadius="0,2,2,0" Background="{StaticResource BrandTeal}"
                        HorizontalAlignment="Left" Visibility="Collapsed" />
                <Grid Margin="12,0,10,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                             Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0"
                             Foreground="{TemplateBinding Foreground}" FontSize="13" VerticalAlignment="Center"
                             Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#14009BA9" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#22006293" />
                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{StaticResource BrandTeal}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#011A46" BorderBrush="#0D3261" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Height="68">
          <controls:MindLinkLogo LogoSize="31" TextFontSize="16" ShowText="{Binding IsSidebarExpanded}"
                                 HorizontalAlignment="Left" Margin="16,0,0,0" />
          <Button Command="{Binding ToggleSidebarCommand}"
                  HorizontalAlignment="Right" Width="34" Height="34" Margin="0,0,8,0"
                  Foreground="#6B8FA3" Content="‹" FontSize="18">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Content" Value="›" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderBrush="#15335B" BorderThickness="0,1,0,0" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource PrimaryGradient}">
              <TextBlock Text="{Binding UserInitials}" Foreground="White" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding UserRole}" Foreground="#6B8FA3" FontSize="10.5" />
            </StackPanel>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SidebarNavigationButton}" Command="{Binding NavigateCommand}"
                      AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /></Grid.RowDefinitions>

      <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
        <Grid Margin="24,0,18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid VerticalAlignment="Center">
            <TextBox Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="34,8,46,8" FontSize="12.5">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#6B8FA3" FontSize="13"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
            <TextBlock Text="Buscar notas, referencias, ideas..." Foreground="#86A3B3" FontSize="12.5"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="⌘K" Foreground="#A2BBC8" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" />
          </Grid>

          <Border Grid.Column="1" Height="32" Margin="16,0,0,0" VerticalAlignment="Center" Background="#EAF8F8"
                  BorderBrush="#A8DFE2" BorderThickness="1" CornerRadius="8" Padding="11,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{StaticResource BrandTeal}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding ActiveProjectTitle}" MaxWidth="254" TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource BrandPetroleum}" FontSize="11.5" FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewNoteCommand}" Padding="15,8" FontSize="11.5" Content="＋  Nueva nota" />
            <Border Margin="10,0,0,0" Padding="10,6" CornerRadius="8" Background="{StaticResource SoftGreen}" BorderBrush="#B9E8CD" BorderThickness="1">
              <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="{StaticResource Success}" FontSize="11" /><TextBlock Text="{Binding StatusMessage}" Foreground="#399762" FontSize="10.5" Margin="6,0,0,0" /></StackPanel>
            </Border>
            <Button Style="{StaticResource IconButton}" Command="{Binding ToggleNotificationsCommand}" Margin="10,0,0,0" Padding="8" MinWidth="34" MinHeight="34">
              <Grid><TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" FontSize="13" /><Border Background="{StaticResource Danger}" CornerRadius="7" Width="14" Height="14" Margin="12,-12,-8,0"><TextBlock Text="3" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
            </Button>
            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BrandPetroleum}" Margin="9,0,0,0">
              <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

      <Border Grid.RowSpan="2" Panel.ZIndex="20" Width="310" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,52,18,0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12"
              Effect="{StaticResource CardShadow}" Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BooleanToVisibility}}">
        <StackPanel>
          <DockPanel><TextBlock Text="Notificaciones" Style="{StaticResource SectionTitle}" /><Button DockPanel.Dock="Right" Command="{Binding CloseNotificationsCommand}" Style="{StaticResource TextButton}" Content="×" Padding="5" /></DockPanel>
          <Border Margin="0,14,0,0" Padding="11" Background="{StaticResource SoftAmber}" CornerRadius="8"><TextBlock Text="2 referencias necesitan completar sus datos bibliográficos." FontSize="11.5" TextWrapping="Wrap" /></Border>
          <Border Margin="0,8,0,0" Padding="11" Background="{StaticResource SoftTeal}" CornerRadius="8"><TextBlock Text="La sección 2.3 tiene una nueva versión guardada." FontSize="11.5" TextWrapping="Wrap" /></Border>
          <Border Margin="0,8,0,0" Padding="11" Background="{StaticResource SoftBlue}" CornerRadius="8"><TextBlock Text="Tu red sumó 28 relaciones esta semana." FontSize="11.5" TextWrapping="Wrap" /></Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
