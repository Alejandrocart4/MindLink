<Window x:Class="MindLink.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:MindLink.Presentation.Views"
        xmlns:vm="clr-namespace:MindLink.Presentation.ViewModels"
        xmlns:controls="clr-namespace:MindLink.Presentation.Controls"
        Title="MindLink"
        Width="1540" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Foreground="{DynamicResource TextPrimary}"
        Background="{StaticResource AppBackground}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38"
                        ResizeBorderThickness="7"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="WindowControlButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#DCEAF1" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#1F4C72" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><views:WelcomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkspaceShellViewModel}"><views:WorkspaceShellView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:NotesViewModel}"><views:NotesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:KnowledgeNetworkViewModel}"><views:KnowledgeNetworkView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReferencesViewModel}"><views:ReferencesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CitationsViewModel}"><views:CitationsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DocumentsViewModel}"><views:DocumentsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExportViewModel}"><views:ExportView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#01153E" BorderBrush="#12345D" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <controls:MindLinkLogo LogoSize="20" TextFontSize="12" TextForeground="White" />
          <TextBlock Text="  ·  Espacio de investigación local" Foreground="#82A9BB"
                     FontSize="10.5" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowControlButton}" Content="&#x2212;"
                  AutomationProperties.Name="Minimizar" ToolTip="Minimizar"
                  Click="MinimizeButton_Click" />
          <Button Style="{StaticResource WindowControlButton}"
                  AutomationProperties.Name="Maximizar o restaurar" ToolTip="Maximizar o restaurar"
                  Click="MaximizeRestoreButton_Click">
            <TextBlock FontFamily="Segoe UI Symbol" FontSize="16">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#x25A1;" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                      <Setter Property="Text" Value="&#x2750;" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
          <Button Style="{StaticResource CloseWindowButton}" Content="&#x00D7;"
                  AutomationProperties.Name="Cerrar" ToolTip="Cerrar"
                  Click="CloseButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
  </Grid>
</Window>
